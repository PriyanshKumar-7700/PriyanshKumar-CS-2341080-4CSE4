class Solution:
    def maxArea(self, mat):
        n = len(mat)
        m = len(mat[0])
        
        heights = [0] * m
        ans = 0
        
        for i in range(n):
       
            for j in range(m):
                if mat[i][j] == 1:
                    heights[j] += 1
                else:
                    heights[j] = 0
                    
            stack = []

            for j in range(m + 1):
                curr = heights[j] if j < m else 0

                while stack and heights[stack[-1]] > curr:
                    h = heights[stack.pop()]
                    width = j if not stack else j - stack[-1] - 1
                    ans = max(ans, h * width)

                stack.append(j)
            
            return ans
